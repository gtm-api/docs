{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "gtm-api",
  "description": "REST API and MCP server for LinkedIn outreach infrastructure: connected accounts, messaging, enrichment, mass actions and webhooks.",
  "colors": {
    "primary": "#65A30D",
    "light": "#C4F148",
    "dark": "#4D7C0F"
  },
  "favicon": "/favicon.svg",
