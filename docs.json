              "directory": "api-reference/linkedin"
            }
          },
          {
            "group": "ID and Teams API",
            "openapi": {
              "source": "api-reference/id/openapi.yaml",
              "directory": "api-reference/id"
            }
          },
          {
            "group": "Orchestration API",
            "openapi": {
              "source": "api-reference/orchestration/openapi.yaml",
              "directory": "api-reference/orchestration"
            }
          }
        ]
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "MCP server",
            "pages": ["mcp/overview", "mcp/connect", "mcp/use-docs-with-ai"]
          }
        ]
      },
      {
        "tab": "Changelog",
        "groups": [
          {
            "group": "Changelog",
            "pages": ["changelog"]
          }
        ]
      }
    ]
