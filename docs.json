          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/envelopes-and-errors",
              "concepts/pagination-and-filtering"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/connect-a-linkedin-account",
              "guides/run-a-mass-action",
              "guides/receive-webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/overview"]
          },
          {
            "group": "LinkedIn API",
            "openapi": {
